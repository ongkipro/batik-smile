---
// src/components/ui/ProductCard.astro
interface Props {
  title: string;
  price: string;
  compareAtPrice?: string;
  image: string;
  material?: string;
  badge?: string;
  href: string;
  variant?: 'mahakarya' | 'signature' | 'essential';
}

const { title, price, compareAtPrice, image, material, badge, href, variant = 'essential' } = Astro.props;

const hasDiscount = compareAtPrice && compareAtPrice !== price;

// Tier Badge Color Palette
const tierBadge = variant === 'mahakarya'
  ? { label: 'Mahakarya', bg: 'bg-[#C5A059]', text: 'text-[#121212]' }
  : variant === 'signature'
    ? { label: 'Signature', bg: 'bg-[#1E3A8A]', text: 'text-white' }
    : { label: 'Essential', bg: 'bg-[#9E4719]', text: 'text-white' };
---

<a href={href} class="group block bg-white rounded-xl sm:rounded-2xl border border-[#161616]/10 p-2 sm:p-3.5 shadow-xs hover:shadow-md hover:border-[#9E4719]/40 transition-all duration-300">
  
  <!-- Image Container 4:5 Ratio -->
  <div class="relative w-full aspect-[4/5] overflow-hidden bg-neutral-100 mb-2 sm:mb-3 rounded-lg sm:rounded-xl border border-neutral-100">
    
    <!-- Tier / Discount Badge -->
    <div class="absolute top-1.5 left-1.5 sm:top-2.5 sm:left-2.5 z-10 flex flex-col gap-1">
      {badge ? (
        <span class="bg-[#9E4719] text-white text-[9px] sm:text-[10px] uppercase tracking-wider font-extrabold px-1.5 sm:px-2 py-0.5 rounded-sm sm:rounded shadow-xs">
          {badge}
        </span>
      ) : variant !== 'essential' ? (
        <span class={`${tierBadge.bg} ${tierBadge.text} text-[9px] sm:text-[10px] uppercase tracking-wider font-extrabold px-1.5 sm:px-2 py-0.5 rounded-sm sm:rounded shadow-xs`}>
          {tierBadge.label}
        </span>
      ) : hasDiscount ? (
        <span class="bg-red-700 text-white text-[9px] sm:text-[10px] uppercase tracking-wider font-extrabold px-1.5 sm:px-2 py-0.5 rounded-sm sm:rounded shadow-xs">
          Diskon
        </span>
      ) : null}
    </div>

    <img 
      src={image} 
      alt={title} 
      loading="lazy" 
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
    />
    
    <!-- Quick View Overlay on Hover (Desktop) -->
    <div class="absolute bottom-0 left-0 w-full p-2.5 translate-y-full opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 hidden lg:block">
      <span class="block w-full text-center bg-white/95 backdrop-blur text-[#121212] text-xs uppercase tracking-wider font-bold py-2 shadow-md hover:bg-[#9E4719] hover:text-white transition-colors rounded-lg">
        Lihat Detail Produk
      </span>
    </div>
  </div>

  <!-- Product Details (High Contrast & Clear Hierarchy) -->
  <div class="flex flex-col text-left px-0.5 sm:px-1">
    
    <!-- Material / Category Tag -->
    {material && (
      <span class="font-sans text-[9px] sm:text-[11px] uppercase tracking-wider text-[#9E4719] font-bold mb-0.5 sm:mb-1 block truncate">
        {material}
      </span>
    )}
    
    <!-- Product Title: High Contrast #121212 on White -->
    <h3 class="font-sans text-[12px] sm:text-[14px] font-bold text-[#121212] group-hover:text-[#9E4719] transition-colors leading-[1.3] line-clamp-2 min-h-[2.6em] mb-1.5 sm:mb-2">
      {title}
    </h3>
    
    <!-- Price & Strikethrough Price -->
    <div class="flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5 mt-auto pt-1 sm:pt-1.5 border-t border-neutral-100">
      <p class="font-sans text-[13px] sm:text-base font-extrabold text-[#9E4719] tracking-tight leading-tight">
        {price}
      </p>
      {hasDiscount && (
        <span class="font-sans text-[10px] sm:text-xs line-through text-neutral-400 font-normal leading-tight">
          {compareAtPrice}
        </span>
      )}
    </div>

  </div>
</a>
