---
// src/components/global/Footer.astro
---

<footer class="bg-[#101010] text-[#FAF7F2] border-t border-white/10 pt-16 pb-28 lg:pb-14 relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- 4 Columns Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-10">
      
      <!-- Col 1: Brand, Heritage & Socials -->
      <div class="space-y-6">
        <a href="/" class="flex flex-col items-start group">
          <span class="font-serif text-3xl font-medium tracking-tight text-white group-hover:text-[#C5A059] transition-colors leading-none">
            Batik Smile
          </span>
          <div class="flex items-center gap-2 mt-2">
            <span class="w-3.5 h-[1.5px] bg-[#C5A059]"></span>
            <span class="font-sans text-[9px] tracking-[0.25em] text-[#C5A059] uppercase font-semibold">
              Mahakarya Nusantara
            </span>
          </div>
        </a>
        
        <p class="font-sans text-xs sm:text-sm text-white/70 leading-relaxed font-light">
          Mengabadikan keagungan motif Nusantara sejak 2007 di Semarang. Menyajikan balutan sutra ATBM prada emas, tenun dobby, dan katun primisima dengan lapisan furing hero halus.
        </p>

        <!-- Social Media & Official Channels -->
        <div class="space-y-3 pt-1">
          <span class="text-[10px] uppercase tracking-[0.2em] text-[#C5A059] font-semibold block">
            Channel Resmi:
          </span>
          <div class="flex items-center gap-3">
            <!-- Instagram -->
            <a 
              href="https://instagram.com/Batiksmile.official" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-white hover:bg-gradient-to-tr hover:from-amber-600 hover:via-pink-600 hover:to-purple-600 hover:border-transparent transition-all shadow-sm group" 
              aria-label="Instagram Official"
            >
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
              </svg>
            </a>

            <!-- WhatsApp -->
            <a 
              href="https://wa.me/6281390888809" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-white hover:bg-[#25D366] hover:border-transparent transition-all shadow-sm group" 
              aria-label="WhatsApp CS"
            >
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </a>

            <!-- Shopee -->
            <a 
              href="https://shopee.co.id" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-white hover:bg-[#EE4D2D] hover:border-transparent transition-all shadow-sm group" 
              aria-label="Shopee Official"
            >
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                <path d="M3 6h18"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
            </a>

            <!-- Google Maps -->
            <a 
              href="https://maps.google.com/?q=Batik+Smile+Pamularsih+Semarang" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-white hover:bg-[#4285F4] hover:border-transparent transition-all shadow-sm group" 
              aria-label="Google Maps Location"
            >
              <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Col 2: Koleksi Busana -->
      <div>
        <div class="flex items-center gap-2 border-b border-white/10 pb-3 mb-5">
          <svg class="w-4 h-4 text-[#C5A059]" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
          <h4 class="font-serif text-lg text-white font-medium">
            Koleksi Busana
          </h4>
        </div>
        
        <ul class="space-y-3 font-light">
          <li>
            <a href="/collections/sarimbit-mahakarya-heritage" class="flex items-center gap-2.5 text-xs text-white/80 hover:text-[#C5A059] transition-colors group">
              <span class="w-1.5 h-1.5 rounded-full bg-[#C5A059] group-hover:scale-125 transition-transform"></span>
              <span>Sarimbit Mahakarya</span>
            </a>
          </li>
          <li>
            <a href="/collections/sarimbit-signature-elegance" class="flex items-center gap-2.5 text-xs text-white/80 hover:text-[#C5A059] transition-colors group">
              <span class="w-1.5 h-1.5 rounded-full bg-[#93C5FD] group-hover:scale-125 transition-transform"></span>
              <span>Sarimbit Signature</span>
            </a>
          </li>
          <li>
            <a href="/collections/sarimbit-essential-daily" class="flex items-center gap-2.5 text-xs text-white/80 hover:text-[#C5A059] transition-colors group">
              <span class="w-1.5 h-1.5 rounded-full bg-[#F59E0B] group-hover:scale-125 transition-transform"></span>
              <span>Sarimbit Essential</span>
            </a>
          </li>
          <li>
            <a href="/collections/batik-wanita" class="flex items-center gap-2.5 text-xs text-white/80 hover:text-[#C5A059] transition-colors group">
              <span class="w-1.5 h-1.5 rounded-full bg-white/40 group-hover:scale-125 transition-transform"></span>
              <span>Batik Wanita</span>
            </a>
          </li>
          <li>
            <a href="/collections/batik-pria" class="flex items-center gap-2.5 text-xs text-white/80 hover:text-[#C5A059] transition-colors group">
              <span class="w-1.5 h-1.5 rounded-full bg-white/40 group-hover:scale-125 transition-transform"></span>
              <span>Batik Pria</span>
            </a>
          </li>
          <li>
            <a href="/collections/batik-anak" class="flex items-center gap-2.5 text-xs text-white/80 hover:text-[#C5A059] transition-colors group">
              <span class="w-1.5 h-1.5 rounded-full bg-white/40 group-hover:scale-125 transition-transform"></span>
              <span>Batik Anak & Adat</span>
            </a>
          </li>
          <li class="pt-1">
            <a href="/collections/shop" class="flex items-center gap-2 text-xs text-[#C5A059] font-semibold hover:underline group">
              <span>Semua Koleksi</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Halaman & Layanan Resmi -->
      <div>
        <div class="flex items-center gap-2 border-b border-white/10 pb-3 mb-5">
          <svg class="w-4 h-4 text-[#C5A059]" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
            <path d="M6 6h10"/>
            <path d="M6 10h10"/>
          </svg>
          <h4 class="font-serif text-lg text-white font-medium">
            Tentang & Layanan
          </h4>
        </div>

        <ul class="space-y-3 font-light">
          <li>
            <a href="/tentang-kami" class="flex items-center gap-2.5 text-xs text-white/80 hover:text-[#C5A059] transition-colors group">
              <svg class="w-4 h-4 text-[#C5A059]/70 group-hover:text-[#C5A059] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 16v-4M12 8h.01" />
              </svg>
              <span>Tentang Kami</span>
            </a>
          </li>
          <li>
            <a href="/layanan-seragam" class="flex items-center gap-2.5 text-xs text-white/80 hover:text-[#C5A059] transition-colors group">
              <svg class="w-4 h-4 text-[#C5A059]/70 group-hover:text-[#C5A059] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
                <circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" />
                <line x1="20" y1="4" x2="8.12" y2="15.88" />
                <line x1="14.47" y1="14.48" x2="20" y2="20" />
                <line x1="8.12" y1="8.12" x2="12" y2="12" />
              </svg>
              <span>Layanan Jahit</span>
            </a>
          </li>
          <li>
            <a href="/fasilitas-store" class="flex items-center gap-2.5 text-xs text-white/80 hover:text-[#C5A059] transition-colors group">
              <svg class="w-4 h-4 text-[#C5A059]/70 group-hover:text-[#C5A059] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
                <path d="M3 21h18M3 7v1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7m0 1a3 3 0 0 0 6 0V7H3l2-4h14l2 4M5 21V10.85a3 3 0 0 0-2-.85m18 11V10.85a3 3 0 0 1-2-.85M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"/>
              </svg>
              <span>Fasilitas Store</span>
            </a>
          </li>
          <li>
            <a href="/lokasi-toko" class="flex items-center gap-2.5 text-xs text-white/80 hover:text-[#C5A059] transition-colors group">
              <svg class="w-4 h-4 text-[#C5A059]/70 group-hover:text-[#C5A059] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span>Lokasi Toko</span>
            </a>
          </li>
          <li>
            <a href="/cart" class="flex items-center gap-2.5 text-xs text-white/80 hover:text-[#C5A059] transition-colors group">
              <svg class="w-4 h-4 text-[#C5A059]/70 group-hover:text-[#C5A059] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
              <span>Tas Belanja</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Showroom Semarang -->
      <div>
        <div class="flex items-center gap-2 border-b border-white/10 pb-3 mb-5">
          <svg class="w-4 h-4 text-[#C5A059]" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <h4 class="font-serif text-lg text-white font-medium">
            Showroom Semarang
          </h4>
        </div>

        <ul class="space-y-4 font-light text-xs text-white/75 leading-relaxed">
          <li class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-md bg-white/10 flex items-center justify-center text-[#C5A059] font-bold text-[10px] flex-shrink-0 mt-0.5">
              1
            </span>
            <div>
              <strong class="text-white block font-medium">Store Pamularsih (3 Lantai):</strong>
              <span>Jl. Simongan Raya No. 109, Semarang</span>
            </div>
          </li>

          <li class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-md bg-white/10 flex items-center justify-center text-[#C5A059] font-bold text-[10px] flex-shrink-0 mt-0.5">
              2
            </span>
            <div>
              <strong class="text-white block font-medium">Store Banyumanik:</strong>
              <span>Jl. Sukun Raya No. 23, Semarang</span>
            </div>
          </li>

          <li class="flex items-center gap-3 pt-1 border-t border-white/10 text-white/80">
            <svg class="w-4 h-4 text-[#25D366] flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>Buka Setiap Hari: 08.00 – 21.00 WIB</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Payment & Logistics Trust Badges -->
    <div class="mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Security Badges -->
      <div class="flex items-center gap-4 text-xs text-white/60 font-light">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[#C5A059]" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <span>Shopify SSL 256-Bit Encrypted</span>
        </div>
        <span class="text-white/20">•</span>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-[#C5A059]" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>Garansi Furing Hero & Pas Ukuran</span>
        </div>
      </div>

      <!-- Copyright -->
      <p class="text-[11px] text-white/40 font-sans text-center md:text-right">
        &copy; {new Date().getFullYear()} Batik Smile Nusantara. Hak Cipta Dilindungi.<br>
        <span class="text-[10px] text-white/30">Semarang & Solo Heritage • Headless Storefront</span>
      </p>

    </div>

  </div>
</footer>
