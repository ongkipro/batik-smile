---
// src/components/global/Header.astro
import MegaMenu from './MegaMenu.tsx';
import HeaderCartButton from './HeaderCartButton.tsx';
---

<header class="sticky top-0 left-0 w-full z-40 transition-all duration-300 backdrop-blur-xl bg-[#FAF7F2]/90 border-b border-[#161616]/8 shadow-[0_2px_15px_rgba(0,0,0,0.02)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 lg:h-20 flex items-center justify-between gap-6">
    
    <!-- Brand Logo (Left - Couture Typography) -->
    <div class="flex-shrink-0 flex items-center">
      <a href="/" class="flex flex-col items-start group">
        <span class="font-serif text-2xl lg:text-3xl font-medium tracking-tight text-[#161616] group-hover:text-[#9E4719] transition-colors leading-none">
          Batik Smile
        </span>
        <div class="flex items-center gap-1.5 mt-1">
          <span class="w-2.5 h-[1px] bg-[#9E4719]"></span>
          <span class="font-sans text-[9px] tracking-[0.25em] text-[#9E4719] uppercase font-semibold">
            Mahakarya Nusantara
          </span>
        </div>
      </a>
    </div>

    <!-- Desktop Navigation (MegaMenu Component - Center) -->
    <div class="hidden lg:flex items-center justify-center flex-1 min-w-0 h-full">
      <MegaMenu client:load />
    </div>

    <!-- Right Actions: Pure Icons Only (Search & Cart) -->
    <div class="flex-shrink-0 flex items-center gap-1 sm:gap-2">
      <!-- Search Button (Icon Only -> Triggers Live Search Modal) -->
      <button 
        id="btn-open-search"
        type="button"
        aria-label="Cari Karya Batik" 
        class="text-[#161616] hover:text-[#9E4719] transition-colors p-2.5 rounded-full hover:bg-black/5 flex items-center justify-center"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </button>
      
      <!-- Cart Button (Icon Only -> Navigates to /cart Page) -->
      <HeaderCartButton client:load />
    </div>
    
  </div>
</header>

<script>
  // Trigger search modal on click
  const searchBtn = document.getElementById('btn-open-search');
  if (searchBtn) {
    searchBtn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-search-modal'));
    });
  }
</script>
