---
// src/components/global/AtelierBanner.astro
import BatikCorner from '../ui/BatikCorner.astro';
import BatikDivider from '../ui/BatikDivider.astro';
---

<section class="w-full bg-[#FAF7F2] py-12 sm:py-16 border-t border-[#161616]/8 relative overflow-hidden">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute -left-20 top-1/2 -translate-y-1/2 w-80 h-80 bg-[#9E4719]/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -right-20 top-1/2 -translate-y-1/2 w-80 h-80 bg-[#C5A059]/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="p-8 sm:p-12 rounded-3xl bg-[#141414] text-[#FAF7F2] border border-white/10 shadow-2xl flex flex-col lg:flex-row items-center justify-between gap-8 relative overflow-hidden">
      
      <!-- Luxury Batik Corner Ornaments -->
      <BatikCorner position="top-left" variant="gold" className="absolute top-3 left-3 hidden sm:block" size={36} />
      <BatikCorner position="bottom-right" variant="gold" className="absolute bottom-3 right-3 hidden sm:block" size={36} />

      <!-- Text Narrative -->
      <div class="space-y-3 text-center lg:text-left max-w-3xl relative z-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#C5A059]/15 border border-[#C5A059]/30 text-[#C5A059] text-[10px] uppercase tracking-[0.25em] font-bold">
          <!-- Mini Kawung -->
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
            <circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" />
            <line x1="20" y1="4" x2="8.12" y2="15.88" />
            <line x1="14.47" y1="14.48" x2="20" y2="20" />
            <line x1="8.12" y1="8.12" x2="12" y2="12" />
          </svg>
          <span>Private Atelier & Konsultasi Butik</span>
        </div>

        <h2 class="font-serif text-2xl sm:text-4xl text-white font-normal leading-tight tracking-tight">
          Butuh Panduan Ukuran atau Jahit Seragam Kustom?
        </h2>

        <p class="font-sans text-xs sm:text-sm text-white/75 font-light leading-relaxed">
          Tim konsultan Batik Smile siap melayani konsultasi pemilihan corak, panduan ukuran pas badan, dan pemesanan seragam instansi/keluarga tanpa minimal order.
        </p>

        <div class="pt-2 flex flex-wrap items-center justify-center lg:justify-start gap-4 text-xs">
          <a href="/layanan-seragam" class="text-[#C5A059] hover:underline font-medium flex items-center gap-1.5">
            <span>Pelajari Layanan Seragam & Jahit Kustom</span>
            <span>→</span>
          </a>
          <span class="text-white/20 hidden sm:inline">•</span>
          <a href="/fasilitas-store" class="text-white/60 hover:text-white transition-colors">
            Showroom 3 Lantai Semarang
          </a>
        </div>
      </div>

      <!-- Action Button (WhatsApp Direct) -->
      <div class="flex-shrink-0 relative z-10">
        <a
          href="https://wa.me/6281390888809?text=Halo%20Batik%20Smile,%20saya%20ingin%20konsultasi%20pemesanan%20batik%20dan%20seragam"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-8 py-4 bg-[#25D366] hover:bg-[#1EBE5D] text-white font-sans text-xs uppercase tracking-[0.2em] font-bold rounded-full shadow-2xl transition-all gap-2.5 hover:scale-105"
        >
          <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c4.54 0 8.24 3.7 8.24 8.24 0 2.2-.86 4.28-2.42 5.84a8.19 8.19 0 0 1-5.82 2.41h-.01c-1.49 0-2.95-.39-4.23-1.14l-.3-.18-3.14.82.84-3.06-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.42 1.44.54.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.59.21-1.09.15-1.18-.06-.1-.23-.16-.48-.28Z"/>
          </svg>
          <span>Hubungi WhatsApp (081-390-8888-09)</span>
        </a>
      </div>

    </div>
  </div>
</section>
