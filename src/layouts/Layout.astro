---
import '../styles/global.css';
import AnnouncementBar from '../components/global/AnnouncementBar.astro';
import Header from '../components/global/Header.astro';
import AtelierBanner from '../components/global/AtelierBanner.astro';
import Footer from '../components/global/Footer.astro';
import MobileNavigation from '../components/global/MobileNavigation.tsx';
import SearchModal from '../components/global/SearchModal.tsx';

interface Props {
	title?: string;
	description?: string;
}

const { 
  title = "Batik Smile Nusantara | Mahakarya Sarimbit & Busana Batik Sejak 2007", 
  description = "Toko busana batik resmi Batik Smile Semarang. Spesialis sarimbit keluarga 3 kasta, kemeja pria furing hero, blus & tunik wanita, serta jahit kustom tanpa minimal order." 
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
    <!-- Fonts: Cormorant Garamond & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-[#FAF7F2] text-[#161616] font-sans antialiased min-h-screen flex flex-col selection:bg-[#9E4719] selection:text-white">
    <!-- Announcement Bar -->
    <AnnouncementBar />

    <!-- Sticky Header & Mega Menu -->
    <Header />

    <!-- Main Content -->
		<main class="flex-grow">
			<slot />
		</main>

    <!-- Atelier & Custom Tailoring Banner (Above Footer) -->
    <AtelierBanner />

    <!-- Premium Footer -->
    <Footer />
    
    <!-- Client Global Search & Mobile Nav -->
    <SearchModal client:load />
    <MobileNavigation client:load />
	</body>
</html>
