---
// src/pages/collections/[handle].astro
import Layout from '../../layouts/Layout.astro';
import BatikDivider from '../../components/ui/BatikDivider.astro';
import CollectionFilterView from '../../components/collection/CollectionFilterView.tsx';
import { shopifyFetch, getCollectionQuery, getProductsQuery } from '../../lib/shopify';

export async function getStaticPaths() {
  const shopifyCollections = [
    'batik-wanita',
    'batik-pria',
    'batik-anak',
    'sarimbit-batik-couple',
    'blus-batik-wanita',
    'outer-tunik-batik',
    'tunik-batik-wanita',
    'dress-batik-wanita',
    'gamis-batik-wanita',
    'outer-batik-wanita',
    'blazer-batik-wanita',
    'inner-busana-batik',
    'kebaya-batik-modern',
    'jarik-kain-batik',
    'daster-batik-solo',
    'kemeja-batik-lengan-panjang',
    'hem-batik-lengan-pendek',
    'celana-batik-pria',
    'blus-batik-anak-cewek',
    'gamis-batik-anak',
    'dress-batik-anak',
    'kebaya-batik-anak',
    'jarik-anak',
    'babydoll-batik-anak',
    'hem-batik-anak-cowo',
    'surjan-batik-anak',
    'blangkon-tradisional',
    'sarung-batik-anak',
    'sarimbit-mahakarya-heritage',
    'sarimbit-signature-elegance',
    'sarimbit-essential-daily',
    'shop',
    'frontpage',
    // Aliases
    'koleksi-wanita',
    'koleksi-pria',
    'koleksi-anak-anak',
    'sarimbit-keluarga',
    'kain-batik-bahan-jahit',
    'aksesoris-oleh-oleh-semarang',
    'tunik-batik-modern',
    'outer-cardigan-batik',
    'blazer-batik-formal',
    'mahakarya',
    'signature',
    'essential',
    'semua'
  ];

  let paths = shopifyCollections.map(handle => ({ params: { handle } }));

  try {
    const query = `{
      collections(first: 100) {
        edges {
          node {
            handle
          }
        }
      }
    }`;
    const { body } = await shopifyFetch({ query });
    const fetchedEdges = (body as any)?.data?.collections?.edges || [];
    const dynamicPaths = fetchedEdges.map((edge: any) => ({
      params: { handle: edge.node.handle }
    }));
    paths = [...paths, ...dynamicPaths];
  } catch (e) {
    console.error("Error fetching collection paths:", e);
  }

  const uniqueHandles = Array.from(new Set(paths.map(p => p.params.handle)));
  return uniqueHandles.map(handle => ({ params: { handle } }));
}

const { handle } = Astro.params;

// Handle Aliases mapping to exact Shopify handles
let actualHandle = handle;
if (handle === 'koleksi-wanita') actualHandle = 'batik-wanita';
if (handle === 'koleksi-pria') actualHandle = 'batik-pria';
if (handle === 'koleksi-anak-anak') actualHandle = 'batik-anak';
if (handle === 'sarimbit-keluarga') actualHandle = 'sarimbit-batik-couple';
if (handle === 'tunik-batik-modern') actualHandle = 'tunik-batik-wanita';
if (handle === 'outer-cardigan-batik') actualHandle = 'outer-batik-wanita';
if (handle === 'blazer-batik-formal') actualHandle = 'blazer-batik-wanita';
if (handle === 'kain-batik-bahan-jahit') actualHandle = 'jarik-kain-batik';
if (handle === 'aksesoris-oleh-oleh-semarang') actualHandle = 'blangkon-tradisional';
if (handle === 'mahakarya') actualHandle = 'sarimbit-mahakarya-heritage';
if (handle === 'signature') actualHandle = 'sarimbit-signature-elegance';
if (handle === 'essential') actualHandle = 'sarimbit-essential-daily';
if (handle === 'semua') actualHandle = 'shop';

// Fetch collection live from Shopify
let collection: any = null;
let products: any[] = [];

try {
  const { body } = await shopifyFetch({
    query: getCollectionQuery,
    variables: { handle: actualHandle },
  });
  collection = (body as any)?.data?.collection;
  products = collection?.products?.edges?.map((edge: any) => edge.node) || [];
} catch (e) {
  console.error("Failed to fetch collection from Shopify:", e);
}

// Fallback jika koleksi kosong / tidak ditemukan, tarik 50 produk umum live dari Shopify
if (products.length === 0) {
  try {
    const fallback = await shopifyFetch({
      query: getProductsQuery,
      variables: { first: 50 }
    });
    products = (fallback.body as any)?.data?.products?.edges?.map((edge: any) => edge.node) || [];
  } catch (e) {
    console.error("Fallback query failed:", e);
  }
}

// Default collection metadata jika null
if (!collection) {
  const formattedTitle = handle?.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) || "Koleksi Mahakarya";
  collection = {
    title: formattedTitle,
    handle: actualHandle,
    descriptionHtml: "<p>Koleksi busana batik tradisional eksklusif dengan keanggunan motif Nusantara, dibuat dengan dedikasi pengrajin lokal sejak 2007.</p>",
    image: {
      url: "https://cdn.shopify.com/s/files/1/0813/3224/0441/collections/banner_shop_all_1786007684766.jpg?v=1786007711"
    }
  };
}

// 3-Tier UI Engine Logic
const isMahakarya = actualHandle?.includes('mahakarya');
const isSignature = actualHandle?.includes('signature');

const tierLabel = isMahakarya
  ? 'Kasta Tertinggi • Sutra Prada'
  : isSignature
    ? 'Signature Series • Dobby & Primisima'
    : 'Koleksi Batik Smile Semarang';
---

<Layout title={`${collection.title} | Batik Smile Semarang`}>
  <div class="min-h-screen bg-[#FAF7F2] text-[#121212]">
    
    <!-- 1. HERO HEADER (High Contrast & Clear Typography) -->
    <section class="w-full py-12 sm:py-16 bg-[#F2EDE4] border-b border-neutral-200">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        <span class="inline-block px-3.5 py-1 rounded-full bg-[#9E4719]/10 text-[#9E4719] text-xs uppercase tracking-wider font-bold mb-3 border border-[#9E4719]/20">
          {tierLabel}
        </span>
        
        <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl text-[#121212] font-semibold mb-3 tracking-tight">
          {collection.title}
        </h1>
        
        <BatikDivider variant="bronze" className="my-3" />
        
        <div class="font-sans text-xs sm:text-sm text-[#404040] max-w-2xl mx-auto leading-relaxed font-normal" set:html={collection.descriptionHtml} />
        
      </div>
    </section>

    <!-- 2. REACTIVE COLLECTION FILTER & PRODUCT GRID (Shadcn-Inspired UI) -->
    <CollectionFilterView 
      client:load 
      initialProducts={products} 
      collectionTitle={collection.title} 
      collectionHandle={actualHandle} 
    />

    <!-- 3. BOTTOM CTA / SHOP ALL -->
    <div class="pb-16 text-center">
      <a 
        href="/collections/shop" 
        class="inline-flex items-center justify-center px-9 py-4 font-sans text-xs uppercase tracking-wider font-bold border-2 border-[#121212] hover:border-[#9E4719] hover:bg-[#9E4719] hover:text-white text-[#121212] transition-all duration-300 rounded-xl shadow-sm cursor-pointer"
      >
        Jelajahi Seluruh Katalog
        <svg class="ml-2.5 w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
          <path d="M5 12h14M12 5l7 7-7 7" strokeLinecap="round" strokeLinejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- 4. BOTTOM SEO CONTENT BLOCK -->
    <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-t border-neutral-200">
      <h3 class="font-serif text-xl sm:text-2xl mb-3 text-[#9E4719] font-semibold">
        Tentang Koleksi {collection.title} - Batik Smile Semarang
      </h3>
      <p class="font-sans text-xs sm:text-sm text-[#404040] leading-relaxed mb-3 font-normal">
        Batik Smile didirikan di Semarang pada tahun 2007 untuk menghadirkan mahakarya busana batik berkualitas tinggi bagi seluruh keluarga Indonesia. Kami memadukan corak klasik Keraton Solo, Yogyakarta, dan Pesisiran Semarangan dengan rancangan kontemporer yang pas dikenakan untuk berbagai agenda formal maupun kasual.
      </p>
      <p class="font-sans text-xs sm:text-sm text-[#404040] leading-relaxed font-normal">
        Setiap produk dalam kategori <strong>{collection.title}</strong> diproduksi dengan pengawasan ketat, menggunakan kain pilihan yang adem, nyaman di kulit, dan dilengkapi furing halus untuk menjaga kenyamanan sepanjang hari. Kami juga melayani jahit kustom seragam keluarga tanpa minimal order dengan layanan pelanggan 3S 1C 1T 1H.
      </p>
    </section>

  </div>
</Layout>
