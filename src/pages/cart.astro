---
// src/pages/cart.astro
import Layout from '../layouts/Layout.astro';
import CartView from '../components/cart/CartView.tsx';
---

<Layout title="Tas Belanja | Batik Smile Semarang">
  <div class="min-h-[75vh] py-8 sm:py-14 bg-[#FAF7F2]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header (Clean & Focused) -->
      <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-12">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full border border-[#C5A059]/40 bg-[#C5A059]/10 text-[#9E4719] mb-3 shadow-sm">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
            <path d="M3 6h18"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
        </div>
        <span class="text-[#9E4719] font-sans text-xs sm:text-sm uppercase tracking-wider font-bold mb-1 block">
          Konfirmasi Pesanan
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-[#121212] font-semibold">
          Tas Belanja Anda
        </h1>
        <p class="font-sans text-xs sm:text-sm text-[#404040] mt-2 font-normal">
          Periksa kembali pilihan busana, varian ukuran, dan catatan khusus jahitan Anda sebelum lanjut ke pembayaran resmi.
        </p>
      </div>

      <!-- Reactive Cart View Component -->
      <CartView client:load />

    </div>
  </div>
</Layout>
