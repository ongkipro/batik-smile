---
// src/pages/products/[handle].astro
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ui/ProductCard.astro';
import BatikDivider from '../../components/ui/BatikDivider.astro';
import { shopifyFetch, getProductQuery, getProductsQuery } from '../../lib/shopify';

export async function getStaticPaths() {
  try {
    const { body } = await shopifyFetch({
      query: getProductsQuery,
      variables: { first: 50 },
    });

    const products = (body as any)?.data?.products?.edges || [];
    return products.map((edge: any) => ({
      params: { handle: edge.node.handle },
    }));
  } catch (error) {
    console.error("Error generating static paths for products:", error);
    return [];
  }
}

const { handle } = Astro.params;

let product: any = null;
let relatedProducts: any[] = [];

try {
  const { body } = await shopifyFetch({
    query: getProductQuery,
    variables: { handle },
  });
  product = (body as any)?.data?.product;

  if (product) {
    // Fetch related products for cross-selling
    const relatedRes = await shopifyFetch({
      query: getProductsQuery,
      variables: { first: 4 },
    });
    const all = (relatedRes.body as any)?.data?.products?.edges || [];
    relatedProducts = all
      .map((e: any) => e.node)
      .filter((p: any) => p.handle !== handle)
      .slice(0, 4);
  }
} catch (error) {
  console.error(`Error fetching product [${handle}]:`, error);
}

if (!product) {
  return Astro.redirect('/404');
}

// Extract product metadata & Tier Detection
const tags = product.tags || [];
const tagStr = tags.join(' ').toLowerCase();
const isMahakarya = tagStr.includes('mahakarya') || tagStr.includes('sutra') || product.title.toLowerCase().includes('sutra');
const isSignature = tagStr.includes('signature') || tagStr.includes('dobby') || product.title.toLowerCase().includes('dobby');
const isEssential = !isMahakarya && !isSignature;

const tierInfo = isMahakarya
  ? { name: 'Kasta Mahakarya', material: 'Sutra ATBM Prada Emas Murni', badgeBg: 'bg-[#C5A059]', badgeText: 'text-[#121212]', border: 'border-[#C5A059]' }
  : isSignature
    ? { name: 'Signature Series', material: 'Tenun Dobby Premium Bertekstur', badgeBg: 'bg-[#1E3A8A]', badgeText: 'text-white', border: 'border-[#1E3A8A]' }
    : { name: 'Essential Daily', material: 'Katun Primisima Sanforized', badgeBg: 'bg-[#9E4719]', badgeText: 'text-white', border: 'border-[#9E4719]' };

const primaryImage = product.featuredImage?.url || "https://cdn.shopify.com/s/files/1/0813/3224/0441/collections/banner_shop_all_1786007684766.jpg?v=1786007711";
const images = product.images?.edges?.map((e: any) => e.node.url) || [primaryImage];
const mainImage = images[0] || primaryImage;

const defaultVariant = product.variants?.edges?.find((e: any) => e.node.availableForSale)?.node || product.variants?.edges?.[0]?.node;
const defaultVariantId = defaultVariant?.id || '';

const rawPrice = parseInt(defaultVariant?.price?.amount || product.priceRange?.minVariantPrice?.amount || '0');
const rawComparePrice = parseInt(defaultVariant?.compareAtPrice?.amount || product.compareAtPriceRange?.maxVariantPrice?.amount || '0');

const priceStr = rawPrice.toLocaleString('id-ID');
const comparePriceStr = rawComparePrice > rawPrice ? rawComparePrice.toLocaleString('id-ID') : null;
const discountPercent = rawComparePrice > rawPrice ? Math.round(((rawComparePrice - rawPrice) / rawComparePrice) * 100) : 0;

// Structured Variant Map for Client JS
const variantsData = (product.variants?.edges || []).map((e: any) => ({
  id: e.node.id,
  title: e.node.title,
  available: e.node.availableForSale,
  price: parseInt(e.node.price?.amount || '0'),
  comparePrice: e.node.compareAtPrice?.amount ? parseInt(e.node.compareAtPrice.amount) : null,
}));
---

<Layout title={`${product.title} | Batik Smile Semarang`} description={product.description?.slice(0, 150)}>
  
  <div class="min-h-screen py-8 sm:py-12 lg:py-16 bg-[#FAF7F2] text-[#121212]">
    
    <!-- BREADCRUMBS (High Contrast for 35+ Demographic) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6 sm:mb-8">
      <nav class="flex items-center gap-2 font-sans text-xs sm:text-sm font-medium text-[#404040]">
        <a href="/" class="hover:text-[#9E4719] transition-colors">Beranda</a>
        <span class="text-neutral-400">/</span>
        <a href="/collections/shop" class="hover:text-[#9E4719] transition-colors">Katalog</a>
        <span class="text-neutral-400">/</span>
        <span class="text-[#9E4719] font-bold truncate max-w-[220px] sm:max-w-none">{product.title}</span>
      </nav>
    </div>

    <!-- MAIN PRODUCT SECTION -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- MEDIA GALLERY (Columns: 1-7) -->
        <div class="lg:col-span-7 flex flex-col-reverse md:flex-row gap-4">
          
          <!-- Mini Thumbnails -->
          {images.length > 1 && (
            <div class="flex md:flex-col gap-3 overflow-x-auto md:overflow-y-auto md:max-h-[650px] flex-shrink-0 scrollbar-none">
              {images.map((imgUrl: string, idx: number) => (
                <button 
                  class="thumb-btn w-16 h-20 md:w-20 md:h-24 rounded-xl overflow-hidden border-2 border-transparent hover:border-[#9E4719] focus:border-[#9E4719] transition-all flex-shrink-0 opacity-85 hover:opacity-100 shadow-sm cursor-pointer bg-white"
                  data-target-img={imgUrl}
                >
                  <img src={imgUrl} alt={`${product.title} view ${idx + 1}`} class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
          )}

          <!-- Main Hero Image (Large Portrait 4:5) -->
          <div class="flex-1 relative aspect-[4/5] bg-white rounded-3xl overflow-hidden border border-neutral-200 shadow-lg group">
            <img 
              id="main-product-image"
              src={mainImage} 
              alt={product.title} 
              class="w-full h-full object-cover transition-all duration-500 ease-out group-hover:scale-105" 
            />

            <!-- Tier Tag on Image -->
            <span class={`absolute top-4 left-4 ${tierInfo.badgeBg} ${tierInfo.badgeText} text-xs uppercase font-bold tracking-wider px-3.5 py-1.5 rounded-lg shadow-md`}>
              {tierInfo.name}
            </span>
          </div>
        </div>

        <!-- PRODUCT INFO PANEL (Columns: 8-12 - Sticky) -->
        <div class="lg:col-span-5 lg:sticky lg:top-24">
          <div class="p-6 sm:p-8 rounded-3xl bg-white border border-neutral-200 shadow-xl space-y-5">
            
            <!-- Brand & Tags -->
            <div class="flex items-center justify-between gap-2">
              <span class="font-sans text-xs sm:text-sm uppercase tracking-wider font-bold text-[#9E4719]">
                {product.vendor || "Batik Smile Semarang"}
              </span>
              <span class="text-xs font-mono text-neutral-600 bg-neutral-100 px-2.5 py-0.5 rounded-full border border-neutral-200">
                SKU: {handle?.slice(0, 10).toUpperCase()}
              </span>
            </div>

            <!-- Title (High Legibility for 35+ demographic) -->
            <h1 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-semibold leading-[1.25] tracking-tight text-[#121212]">
              {product.title}
            </h1>

            <!-- Price & Compare Price (Clear, Bold, Prominent) -->
            <div class="flex flex-wrap items-baseline gap-3 pb-5 border-b border-neutral-200">
              <span id="product-display-price" class="font-sans text-3xl sm:text-4xl font-extrabold text-[#9E4719] tracking-tight">
                Rp {priceStr}
              </span>
              
              {comparePriceStr && (
                <span id="product-compare-price" class="font-sans text-base sm:text-lg line-through text-neutral-400 font-normal">
                  Rp {comparePriceStr}
                </span>
              )}

              {discountPercent > 0 && (
                <span id="product-discount-badge" class="bg-[#9E4719] text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-md shadow-sm">
                  Hemat {discountPercent}%
                </span>
              )}
            </div>

            <!-- Hidden Inputs & Data Payload for Client JS -->
            <input type="hidden" id="selected-variant-id" value={defaultVariantId} />
            <script id="product-variants-json" type="application/json" set:html={JSON.stringify(variantsData)} />

            <!-- Variants (Size Selector with Large Tap Targets for Mobile/Desktop) -->
            {product.variants?.edges?.length > 0 && product.variants.edges[0]?.node?.title !== 'Default Title' && (
              <div class="space-y-3">
                <div class="flex justify-between items-center">
                  <span class="font-sans text-sm sm:text-base font-bold text-[#121212]">Pilih Ukuran</span>
                  <button 
                    id="btn-open-size-guide" 
                    type="button" 
                    class="font-sans text-xs sm:text-sm font-bold text-[#9E4719] hover:underline flex items-center gap-1.5 cursor-pointer"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                      <rect width="18" height="18" x="3" y="3" rx="2"/>
                      <path d="M3 9h18M9 21V9"/>
                    </svg>
                    Panduan Ukuran (Size Guide)
                  </button>
                </div>

                <div class="grid grid-cols-4 sm:grid-cols-5 gap-2.5">
                  {product.variants.edges.map((edge: any) => {
                    const variant = edge.node;
                    const isAvailable = variant.availableForSale;
                    const isSelected = variant.id === defaultVariantId;
                    return (
                      <button 
                        type="button"
                        data-variant-id={variant.id}
                        data-variant-price={variant.price?.amount}
                        data-variant-compare={variant.compareAtPrice?.amount}
                        disabled={!isAvailable}
                        class={`size-btn h-12 flex items-center justify-center font-sans text-sm sm:text-base tracking-wider uppercase border-2 transition-all rounded-xl font-bold cursor-pointer ${
                          isSelected 
                            ? 'bg-[#9E4719] text-white border-[#9E4719] shadow-md scale-[1.02]' 
                            : isAvailable 
                              ? 'bg-white text-[#121212] border-neutral-300 hover:border-[#9E4719] hover:text-[#9E4719]' 
                              : 'bg-neutral-100 text-neutral-400 border-neutral-200 opacity-40 cursor-not-allowed line-through'
                        }`}
                      >
                        {variant.title}
                      </button>
                    );
                  })}
                </div>
              </div>
            )}

            <!-- Primary CTA Button (Tall & Big for Easy Clicking) -->
            <div>
              <button 
                id="btn-add-to-cart"
                type="button"
                class="w-full py-4.5 px-6 bg-[#9E4719] hover:bg-[#7A320C] text-white font-sans text-sm sm:text-base uppercase tracking-wider font-bold rounded-2xl transition-all duration-300 shadow-xl hover:shadow-[#9E4719]/40 flex items-center justify-center gap-3 group cursor-pointer active:scale-[0.99]"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2">
                  <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
                <span>Tambah Ke Tas Belanja</span>
              </button>
            </div>

            <!-- Accordion Details (Luxury Boutique Cards) -->
            <div class="space-y-3 pt-2">
              
              <!-- Accordion 1: Deskripsi & Filosofi -->
              <details class="group rounded-2xl bg-neutral-50/80 border border-neutral-200 overflow-hidden transition-all duration-200 open:bg-white open:shadow-sm" open>
                <summary class="flex justify-between items-center px-5 py-4 font-sans text-sm sm:text-base font-bold text-[#121212] cursor-pointer select-none group-hover:text-[#9E4719] transition-colors">
                  <span class="flex items-center gap-3">
                    <span class="w-8 h-8 rounded-full bg-[#9E4719]/10 text-[#9E4719] flex items-center justify-center text-sm font-bold">
                      📜
                    </span>
                    <span>Filosofi & Detail Busana</span>
                  </span>
                  <div class="w-7 h-7 rounded-full bg-white border border-neutral-200 flex items-center justify-center text-[#9E4719] shadow-xs group-open:rotate-180 transition-transform">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="m6 9 6 6 6-6"/>
                    </svg>
                  </div>
                </summary>
                <div class="px-5 pb-5 pt-1 border-t border-neutral-100 product-prose" set:html={product.descriptionHtml} />
              </details>

              <!-- Accordion 2: Material & Furing -->
              <details class="group rounded-2xl bg-neutral-50/80 border border-neutral-200 overflow-hidden transition-all duration-200 open:bg-white open:shadow-sm">
                <summary class="flex justify-between items-center px-5 py-4 font-sans text-sm sm:text-base font-bold text-[#121212] cursor-pointer select-none group-hover:text-[#9E4719] transition-colors">
                  <span class="flex items-center gap-3">
                    <span class="w-8 h-8 rounded-full bg-[#C5A059]/15 text-[#9E4719] flex items-center justify-center text-sm font-bold">
                      🧵
                    </span>
                    <span>Spesifikasi Bahan & Furing</span>
                  </span>
                  <div class="w-7 h-7 rounded-full bg-white border border-neutral-200 flex items-center justify-center text-[#9E4719] shadow-xs group-open:rotate-180 transition-transform">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="m6 9 6 6 6-6"/>
                    </svg>
                  </div>
                </summary>
                <div class="px-5 pb-5 pt-3 border-t border-neutral-100 font-sans text-sm sm:text-base leading-[1.7] text-[#333333] space-y-2.5">
                  <div class="flex items-start gap-2.5">
                    <span class="text-[#9E4719] font-bold">✓</span>
                    <span><strong>Kasta Busana:</strong> <span class="font-bold text-[#9E4719]">{tierInfo.name}</span></span>
                  </div>
                  <div class="flex items-start gap-2.5">
                    <span class="text-[#9E4719] font-bold">✓</span>
                    <span><strong>Bahan Dasar:</strong> {tierInfo.material}</span>
                  </div>
                  <div class="flex items-start gap-2.5">
                    <span class="text-[#9E4719] font-bold">✓</span>
                    <span><strong>Lapisan Dalam:</strong> Dilapisi Furing Hero katun halus, sejuk di kulit dan tidak menerawang saat beraktivitas.</span>
                  </div>
                  <div class="flex items-start gap-2.5">
                    <span class="text-[#9E4719] font-bold">✓</span>
                    <span><strong>Jahitan:</strong> Standar butik resmi Semarang dengan jahitan kuat, presisi, dan kancing tertutup rapi.</span>
                  </div>
                </div>
              </details>

              <!-- Accordion 3: Panduan Perawatan -->
              <details class="group rounded-2xl bg-neutral-50/80 border border-neutral-200 overflow-hidden transition-all duration-200 open:bg-white open:shadow-sm">
                <summary class="flex justify-between items-center px-5 py-4 font-sans text-sm sm:text-base font-bold text-[#121212] cursor-pointer select-none group-hover:text-[#9E4719] transition-colors">
                  <span class="flex items-center gap-3">
                    <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center text-sm font-bold">
                      🧼
                    </span>
                    <span>Panduan Perawatan Batik</span>
                  </span>
                  <div class="w-7 h-7 rounded-full bg-white border border-neutral-200 flex items-center justify-center text-[#9E4719] shadow-xs group-open:rotate-180 transition-transform">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="m6 9 6 6 6-6"/>
                    </svg>
                  </div>
                </summary>
                <div class="px-5 pb-5 pt-3 border-t border-neutral-100 font-sans text-sm sm:text-base leading-[1.7] text-[#333333] space-y-2">
                  <p class="flex items-start gap-2">
                    <span class="w-5 h-5 rounded-full bg-neutral-200 text-neutral-700 font-mono text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5">1</span>
                    <span>Cuci menggunakan sabun lerak alami atau deterjen cair lembut non-pemutih.</span>
                  </p>
                  <p class="flex items-start gap-2">
                    <span class="w-5 h-5 rounded-full bg-neutral-200 text-neutral-700 font-mono text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5">2</span>
                    <span>Hindari memeras kain terlalu kuat atau menggunakan mesin pengering putar.</span>
                  </p>
                  <p class="flex items-start gap-2">
                    <span class="w-5 h-5 rounded-full bg-neutral-200 text-neutral-700 font-mono text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5">3</span>
                    <span>Jemur membentang di tempat teduh yang berangin tanpa terkena sinar matahari terik langsung.</span>
                  </p>
                  <p class="flex items-start gap-2">
                    <span class="w-5 h-5 rounded-full bg-neutral-200 text-neutral-700 font-mono text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5">4</span>
                    <span>Setrika pada suhu katun sedang atau lapisi kain tipis di atas permukaan motif batik.</span>
                  </p>
                </div>
              </details>
            </div>

            <!-- Trust Badge (Batik Smile Semarang 2007) -->
            <div class="p-4 rounded-2xl bg-amber-50/90 border border-amber-200 text-center">
              <span class="font-sans text-xs sm:text-sm font-bold text-[#9E4719] block mb-1">
                Layanan 3S 1C 1T 1H • Butik Semarang Sejak 2007
              </span>
              <p class="font-sans text-xs sm:text-sm text-[#404040]">
                Garansi penukaran ukuran bila kurang pas • Showroom Pamularsih & Banyumanik Semarang
              </p>
            </div>

          </div>
        </div>

      </div>
    </div>

    <!-- CROSS-SELLING SECTION -->
    {relatedProducts.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-20 sm:mt-24 pt-16 border-t border-neutral-200">
        <div class="text-center mb-12">
          <span class="font-sans text-xs sm:text-sm uppercase tracking-[0.25em] text-[#9E4719] font-bold block mb-1">
            Harmoni Nusantara
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl text-[#121212] font-semibold leading-[1.2]">
            Padukan Dengan Pasangannya
          </h2>
          <BatikDivider variant="bronze" className="my-3" />
          <p class="font-sans text-xs sm:text-sm text-[#404040] mt-1 leading-[1.6]">
            Sempurnakan penampilan keluarga Anda dengan kombinasi sarimbit selaras.
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-5 sm:gap-7">
          {relatedProducts.map((rel: any) => {
            const relImg = rel.images?.edges?.[0]?.node?.url || "https://cdn.shopify.com/s/files/1/0813/3224/0441/collections/banner_batik_couple_1785995932731_51f1e349-35df-4896-b08d-6290f84897d9.jpg?v=1786005734";
            const minPrice = parseInt(rel.priceRange?.minVariantPrice?.amount || "0");
            const comparePrice = parseInt(rel.compareAtPriceRange?.maxVariantPrice?.amount || "0");
            const relPriceStr = `Rp ${minPrice.toLocaleString('id-ID')}`;
            const comparePriceStr = comparePrice > minPrice ? `Rp ${comparePrice.toLocaleString('id-ID')}` : undefined;

            return (
              <ProductCard
                title={rel.title}
                price={relPriceStr}
                compareAtPrice={comparePriceStr}
                image={relImg}
                href={`/products/${rel.handle}`}
                material={rel.tags?.[0] || 'Karya Serasi'}
                variant="essential"
              />
            );
          })}
        </div>
      </section>
    )}

  </div>

  <!-- MODAL PANDUAN UKURAN (SIZE GUIDE - BESPOKE TABLE FOR 35+) -->
  <div id="modal-size-guide" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/70 backdrop-blur-sm animate-fade-in">
    <div class="bg-[#FAF7F2] rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl border border-neutral-200 relative max-h-[90vh] overflow-y-auto">
      
      <button id="btn-close-size-guide" class="absolute top-5 right-5 w-9 h-9 rounded-full bg-black/5 hover:bg-[#9E4719] hover:text-white flex items-center justify-center text-sm font-bold transition-colors cursor-pointer">
        ✕
      </button>

      <div class="text-center mb-6">
        <span class="text-[#9E4719] font-sans text-xs sm:text-sm uppercase tracking-[0.25em] font-bold block mb-1">
          Standar Butik Batik Smile
        </span>
        <h3 class="font-serif text-2xl sm:text-3xl font-semibold text-[#121212]">Tabel Panduan Ukuran Pas Badan</h3>
      </div>

      <!-- Size Table Tabs -->
      <div class="space-y-6">
        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-neutral-200 shadow-sm">
          <h4 class="font-sans text-sm sm:text-base uppercase tracking-wider font-bold text-[#9E4719] mb-3 pb-1 border-b border-neutral-200">
            1. Pria (Kemeja Lengan Panjang & Hem Furing)
          </h4>
          <div class="overflow-x-auto">
            <table class="w-full text-xs sm:text-sm text-left border-collapse">
              <thead>
                <tr class="bg-neutral-100 text-[#121212]">
                  <th class="p-3 font-bold">Ukuran</th>
                  <th class="p-3 font-bold">Lingkar Dada (LD)</th>
                  <th class="p-3 font-bold">Lebar Bahu</th>
                  <th class="p-3 font-bold">Panjang Baju</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-neutral-100 text-[#2A2A2A]">
                <tr><td class="p-3 font-bold">S</td><td class="p-3">104 cm</td><td class="p-3">44 cm</td><td class="p-3">70 cm</td></tr>
                <tr><td class="p-3 font-bold">M</td><td class="p-3">108 cm</td><td class="p-3">46 cm</td><td class="p-3">72 cm</td></tr>
                <tr><td class="p-3 font-bold">L</td><td class="p-3">112 cm</td><td class="p-3">48 cm</td><td class="p-3">74 cm</td></tr>
                <tr><td class="p-3 font-bold">XL</td><td class="p-3">116 cm</td><td class="p-3">50 cm</td><td class="p-3">76 cm</td></tr>
                <tr><td class="p-3 font-bold">XXL</td><td class="p-3">120 cm</td><td class="p-3">52 cm</td><td class="p-3">78 cm</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-neutral-200 shadow-sm">
          <h4 class="font-sans text-sm sm:text-base uppercase tracking-wider font-bold text-[#9E4719] mb-3 pb-1 border-b border-neutral-200">
            2. Wanita (Blus, Tunik, Gamis & Kebaya)
          </h4>
          <div class="overflow-x-auto">
            <table class="w-full text-xs sm:text-sm text-left border-collapse">
              <thead>
                <tr class="bg-neutral-100 text-[#121212]">
                  <th class="p-3 font-bold">Ukuran</th>
                  <th class="p-3 font-bold">Lingkar Dada (LD)</th>
                  <th class="p-3 font-bold">Panjang Blus</th>
                  <th class="p-3 font-bold">Panjang Gamis</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-neutral-100 text-[#2A2A2A]">
                <tr><td class="p-3 font-bold">S</td><td class="p-3">92 cm</td><td class="p-3">70 cm</td><td class="p-3">135 cm</td></tr>
                <tr><td class="p-3 font-bold">M</td><td class="p-3">96 cm</td><td class="p-3">72 cm</td><td class="p-3">138 cm</td></tr>
                <tr><td class="p-3 font-bold">L</td><td class="p-3">100 cm</td><td class="p-3">74 cm</td><td class="p-3">140 cm</td></tr>
                <tr><td class="p-3 font-bold">XL</td><td class="p-3">104 cm</td><td class="p-3">76 cm</td><td class="p-3">140 cm</td></tr>
                <tr><td class="p-3 font-bold">XXL</td><td class="p-3">110 cm</td><td class="p-3">78 cm</td><td class="p-3">142 cm</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-neutral-200 text-center text-xs sm:text-sm text-[#404040]">
        <p>💡 <em>Butuh ukuran khusus di luar standar? Hubungi WhatsApp Atelier Batik Smile untuk layanan jahit kustom pas badan.</em></p>
      </div>

    </div>
  </div>

</Layout>

<script>
  import { cartStore } from '../../lib/cartStore';

  // Thumbnail switcher
  const thumbBtns = document.querySelectorAll('.thumb-btn');
  const mainImg = document.getElementById('main-product-image') as HTMLImageElement;

  thumbBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetUrl = btn.getAttribute('data-target-img');
      if (mainImg && targetUrl) {
        mainImg.style.opacity = '0.4';
        setTimeout(() => {
          mainImg.src = targetUrl;
          mainImg.style.opacity = '1';
        }, 150);
      }
      thumbBtns.forEach(b => b.classList.remove('border-[#9E4719]', 'opacity-100'));
      btn.classList.add('border-[#9E4719]', 'opacity-100');
    });
  });

  // Size Selector & Price Switcher
  const sizeBtns = document.querySelectorAll('.size-btn');
  const variantInput = document.getElementById('selected-variant-id') as HTMLInputElement;
  const displayPrice = document.getElementById('product-display-price');
  const comparePrice = document.getElementById('product-compare-price');

  sizeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const varId = btn.getAttribute('data-variant-id');
      const varPrice = btn.getAttribute('data-variant-price');
      const varCompare = btn.getAttribute('data-variant-compare');

      if (varId && variantInput) {
        variantInput.value = varId;
      }

      // Update active state styling
      sizeBtns.forEach(b => {
        if (!b.hasAttribute('disabled')) {
          b.className = 'size-btn h-12 flex items-center justify-center font-sans text-sm sm:text-base tracking-wider uppercase border-2 transition-all rounded-xl font-bold cursor-pointer bg-white text-[#121212] border-neutral-300 hover:border-[#9E4719] hover:text-[#9E4719]';
        }
      });
      btn.className = 'size-btn h-12 flex items-center justify-center font-sans text-sm sm:text-base tracking-wider uppercase border-2 transition-all rounded-xl font-bold cursor-pointer bg-[#9E4719] text-white border-[#9E4719] shadow-md scale-[1.02]';

      // Update Price Display
      if (varPrice && displayPrice) {
        const pNum = parseInt(varPrice);
        displayPrice.textContent = `Rp ${pNum.toLocaleString('id-ID')}`;
      }
      if (comparePrice) {
        if (varCompare && parseInt(varCompare) > parseInt(varPrice || '0')) {
          comparePrice.textContent = `Rp ${parseInt(varCompare).toLocaleString('id-ID')}`;
          comparePrice.classList.remove('hidden');
        } else {
          comparePrice.classList.add('hidden');
        }
      }
    });
  });

  // Add to Cart Button Logic
  const addBtn = document.getElementById('btn-add-to-cart');
  if (addBtn) {
    addBtn.addEventListener('click', async () => {
      const variantId = variantInput?.value;
      if (!variantId) return;

      const originalHtml = addBtn.innerHTML;
      addBtn.innerHTML = `
        <div class="inline-block animate-spin w-5 h-5 border-2 border-white border-t-transparent rounded-full mr-2"></div>
        <span>Menambahkan ke Tas...</span>
      `;
      (addBtn as HTMLButtonElement).disabled = true;

      try {
        await cartStore.addItem(variantId, 1);
        window.location.href = '/cart';
      } catch (err) {
        console.error("Gagal menambahkan ke tas belanja:", err);
        addBtn.innerHTML = originalHtml;
        (addBtn as HTMLButtonElement).disabled = false;
      }
    });
  }

  // Modal Panduan Ukuran (Size Guide)
  const openGuideBtn = document.getElementById('btn-open-size-guide');
  const closeGuideBtn = document.getElementById('btn-close-size-guide');
  const modalGuide = document.getElementById('modal-size-guide');

  if (openGuideBtn && modalGuide && closeGuideBtn) {
    openGuideBtn.addEventListener('click', () => {
      modalGuide.classList.remove('hidden');
      modalGuide.classList.add('flex');
    });

    closeGuideBtn.addEventListener('click', () => {
      modalGuide.classList.add('hidden');
      modalGuide.classList.remove('flex');
    });

    modalGuide.addEventListener('click', (e) => {
      if (e.target === modalGuide) {
        modalGuide.classList.add('hidden');
        modalGuide.classList.remove('flex');
      }
    });
  }
</script>
