---
// src/pages/products/[handle].astro
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ui/ProductCard.astro';
import BatikDivider from '../../components/ui/BatikDivider.astro';
import { BookOpen, Layers, Sparkles, ChevronDown, ShieldCheck, Ruler, ShoppingBag } from 'lucide-astro';
import { shopifyFetch, getProductQuery, getProductsQuery } from '../../lib/shopify';

export async function getStaticPaths() {
  try {
    const { body } = await shopifyFetch({
      query: getProductsQuery,
      variables: { first: 50 },
    });

    const products = (body as any)?.data?.products?.edges || [];
    return products.map((edge: any) => ({
      params: { handle: edge.node.handle },
    }));
  } catch (error) {
    console.error("Error generating static paths for products:", error);
    return [];
  }
}

const { handle } = Astro.params;

// Fetch Live Product from Shopify
let product: any = null;
let relatedProducts: any[] = [];

try {
  const { body } = await shopifyFetch({
    query: getProductQuery,
    variables: { handle },
  });
  product = (body as any)?.data?.product;

  // Fetch cross-sell recommendations
  const allProds = await shopifyFetch({
    query: getProductsQuery,
    variables: { first: 8 },
  });
  const allEdges = (allProds.body as any)?.data?.products?.edges || [];
  relatedProducts = allEdges
    .map((e: any) => e.node)
    .filter((p: any) => p.handle !== handle)
    .slice(0, 4);
} catch (e) {
  console.error("Failed to fetch product data from Shopify:", e);
}

if (!product) {
  return Astro.redirect('/404');
}

// 3-Tier Kasta Classification
const tags = (product.tags || []).join(' ').toLowerCase();
const titleLower = product.title.toLowerCase();

const isMahakarya = tags.includes('sutra') || titleLower.includes('sutra') || tags.includes('mahakarya');
const isSignature = tags.includes('dobby') || titleLower.includes('dobby') || tags.includes('signature');

const tierInfo = isMahakarya
  ? {
      name: 'Kasta Mahakarya (Tier 1)',
      badgeBg: 'bg-gradient-to-r from-[#C5A059] to-[#9A7730]',
      badgeText: 'text-[#0A0907]',
      material: 'Sutra ATBM Eksklusif dengan aksen Canting Prada Emas Murni'
    }
  : isSignature
    ? {
        name: 'Signature Series (Tier 2)',
        badgeBg: 'bg-[#1E3A8A]',
        badgeText: 'text-white',
        material: 'Tenun Dobby Modern & Tarum Navy Berwibawa lapis Furing Hero Sejuk'
      }
    : {
        name: 'Essential Daily (Tier 3)',
        badgeBg: 'bg-[#9E4719]',
        badgeText: 'text-white',
        material: 'Katun Primisima Sanforized 100% Halus, Sejuk & Breathable'
      };

const primaryImage = product.featuredImage?.url || "https://cdn.shopify.com/s/files/1/0813/3224/0441/collections/banner_shop_all_1786007684766.jpg?v=1786007711";
const images = product.images?.edges?.map((e: any) => e.node.url) || [primaryImage];
const mainImage = images[0] || primaryImage;

const defaultVariant = product.variants?.edges?.find((e: any) => e.node.availableForSale)?.node || product.variants?.edges?.[0]?.node;
const defaultVariantId = defaultVariant?.id || '';

const rawPrice = parseInt(defaultVariant?.price?.amount || product.priceRange?.minVariantPrice?.amount || '0');
const rawComparePrice = parseInt(defaultVariant?.compareAtPrice?.amount || product.compareAtPriceRange?.maxVariantPrice?.amount || '0');

const priceStr = rawPrice.toLocaleString('id-ID');
const comparePriceStr = rawComparePrice > rawPrice ? rawComparePrice.toLocaleString('id-ID') : null;
const discountPercent = rawComparePrice > rawPrice ? Math.round(((rawComparePrice - rawPrice) / rawComparePrice) * 100) : 0;

// Structured Variant Map for Client JS
const variantsData = (product.variants?.edges || []).map((e: any) => ({
  id: e.node.id,
  title: e.node.title,
  available: e.node.availableForSale,
  price: parseInt(e.node.price?.amount || '0'),
  comparePrice: e.node.compareAtPrice?.amount ? parseInt(e.node.compareAtPrice.amount) : null,
}));
---

<Layout title={`${product.title} | Batik Smile Semarang`} description={product.description?.slice(0, 150)}>
  
  <div class="min-h-screen py-6 sm:py-10 lg:py-14 bg-[#FAF7F2] text-[#121212]">
    
    <!-- BREADCRUMBS -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-4 sm:mb-6">
      <nav class="flex items-center gap-1.5 sm:gap-2 font-sans text-xs sm:text-sm font-medium text-[#505050]">
        <a href="/" class="hover:text-[#9E4719] transition-colors">Beranda</a>
        <span class="text-neutral-300">/</span>
        <a href="/collections/shop" class="hover:text-[#9E4719] transition-colors">Katalog</a>
        <span class="text-neutral-300">/</span>
        <span class="text-[#9E4719] font-bold truncate max-w-[180px] sm:max-w-none">{product.title}</span>
      </nav>
    </div>

    <!-- MAIN PRODUCT SECTION -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-start">
        
        <!-- MEDIA GALLERY (Columns: 1-7) -->
        <div class="lg:col-span-7 flex flex-col-reverse md:flex-row gap-3 sm:gap-4">
          
          <!-- Mini Thumbnails Carousel / Strip -->
          {images.length > 1 && (
            <div class="flex md:flex-col gap-2 sm:gap-2.5 overflow-x-auto md:overflow-y-auto md:max-h-[600px] flex-shrink-0 scrollbar-none py-0.5">
              {images.map((imgUrl: string, idx: number) => (
                <button 
                  class={`thumb-btn w-14 h-18 sm:w-16 sm:h-20 md:w-20 md:h-24 rounded-lg sm:rounded-xl overflow-hidden border-2 transition-all flex-shrink-0 cursor-pointer bg-white ${
                    idx === 0 
                      ? 'border-[#9E4719] opacity-100 ring-2 ring-[#9E4719]/20' 
                      : 'border-neutral-200/80 opacity-70 hover:opacity-100'
                  }`}
                  data-target-img={imgUrl}
                  type="button"
                >
                  <img src={imgUrl} alt={`${product.title} view ${idx + 1}`} class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
          )}

          <!-- Main Hero Image (Large Portrait 4:5 with Clean Subtle Border) -->
          <div class="flex-1 relative aspect-[4/5] bg-white rounded-2xl lg:rounded-3xl overflow-hidden border border-neutral-200/80 shadow-sm group">
            <img 
              id="main-product-image"
              src={mainImage} 
              alt={product.title} 
              class="w-full h-full object-cover transition-all duration-500 ease-out group-hover:scale-105" 
            />

            <!-- Tier Tag on Image -->
            <span class={`absolute top-3 left-3 sm:top-4 sm:left-4 ${tierInfo.badgeBg} ${tierInfo.badgeText} text-[10px] sm:text-xs uppercase font-extrabold tracking-wider px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-md sm:rounded-lg shadow-sm`}>
              {tierInfo.name}
            </span>
          </div>
        </div>

        <!-- PRODUCT INFO PANEL (Columns: 8-12 - Sticky) -->
        <div class="lg:col-span-5 lg:sticky lg:top-24">
          <div class="p-4 sm:p-7 rounded-2xl sm:rounded-3xl bg-white border border-neutral-200/80 shadow-sm sm:shadow-md space-y-4 sm:space-y-5">
            
            <!-- Vendor & SKU Header -->
            <div class="flex items-center justify-between gap-2">
              <span class="font-sans text-xs sm:text-sm uppercase tracking-wider font-extrabold text-[#9E4719]">
                {product.vendor || "Batik Smile Semarang"}
              </span>
              <span class="text-[11px] font-mono text-neutral-500 bg-neutral-100 px-2 py-0.5 rounded border border-neutral-200">
                SKU: {handle?.slice(0, 10).toUpperCase()}
              </span>
            </div>

            <!-- Title -->
            <h1 class="font-serif text-xl sm:text-2xl lg:text-3xl font-semibold leading-snug tracking-tight text-[#121212]">
              {product.title}
            </h1>

            <!-- Price & Strikethrough Row -->
            <div class="flex flex-wrap items-baseline gap-2.5 pb-4 border-b border-neutral-200/80">
              <span id="product-display-price" class="font-sans text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#9E4719] tracking-tight">
                Rp {priceStr}
              </span>
              
              {comparePriceStr && (
                <span id="product-compare-price" class="font-sans text-xs sm:text-base line-through text-neutral-400 font-normal">
                  Rp {comparePriceStr}
                </span>
              )}

              {discountPercent > 0 && (
                <span id="product-discount-badge" class="bg-red-700 text-white text-[10px] sm:text-xs font-extrabold uppercase tracking-wider px-2 py-0.5 rounded shadow-xs">
                  Hemat {discountPercent}%
                </span>
              )}
            </div>

            <!-- Hidden Inputs & Data Payload for Client JS -->
            <input type="hidden" id="selected-variant-id" value={defaultVariantId} />
            <script id="product-variants-json" type="application/json" set:html={JSON.stringify(variantsData)} />

            <!-- Variants (Size Selector) -->
            {product.variants?.edges?.length > 0 && product.variants.edges[0]?.node?.title !== 'Default Title' && (
              <div class="space-y-2.5">
                <div class="flex justify-between items-center">
                  <span class="font-sans text-xs sm:text-sm font-bold text-[#121212] uppercase tracking-wider">Pilih Ukuran:</span>
                  <button 
                    id="btn-open-size-guide" 
                    type="button" 
                    class="font-sans text-xs font-bold text-[#9E4719] hover:underline flex items-center gap-1 cursor-pointer"
                  >
                    <Ruler class="w-3.5 h-3.5 text-[#9E4719]" />
                    <span>Panduan Ukuran</span>
                  </button>
                </div>

                <div class="grid grid-cols-4 sm:grid-cols-5 gap-2">
                  {product.variants.edges.map((edge: any) => {
                    const variant = edge.node;
                    const isAvailable = variant.availableForSale;
                    const isSelected = variant.id === defaultVariantId;
                    return (
                      <button 
                        type="button"
                        data-variant-id={variant.id}
                        data-variant-price={variant.price?.amount}
                        data-variant-compare={variant.compareAtPrice?.amount}
                        disabled={!isAvailable}
                        class={`size-btn h-10 sm:h-11 flex items-center justify-center font-sans text-xs sm:text-sm uppercase tracking-wider border-2 transition-all rounded-lg sm:rounded-xl font-bold cursor-pointer ${
                          isSelected 
                            ? 'bg-[#9E4719] text-white border-[#9E4719] shadow-xs' 
                            : isAvailable 
                              ? 'bg-white text-[#121212] border-neutral-200 hover:border-[#9E4719] hover:text-[#9E4719]' 
                              : 'bg-neutral-100 text-neutral-400 border-neutral-200 opacity-40 cursor-not-allowed line-through'
                        }`}
                      >
                        {variant.title}
                      </button>
                    );
                  })}
                </div>
              </div>
            )}

            <!-- Primary CTA Button (Large Tap Target) -->
            <div>
              <button 
                id="btn-add-to-cart"
                type="button"
                class="w-full py-4 px-6 bg-[#9E4719] hover:bg-[#7A320C] text-white font-sans text-xs sm:text-sm uppercase tracking-wider font-extrabold rounded-xl transition-all duration-300 shadow-lg hover:shadow-[#9E4719]/40 flex items-center justify-center gap-2.5 group cursor-pointer active:scale-[0.99]"
              >
                <ShoppingBag class="w-4 h-4 text-white" />
                <span>Tambah Ke Tas Belanja</span>
              </button>
            </div>

            <!-- Unified Streamlined Accordion Container -->
            <div class="rounded-xl sm:rounded-2xl border border-neutral-200/80 bg-white overflow-hidden divide-y divide-neutral-100">
              
              <!-- Accordion 1: Deskripsi & Filosofi -->
              <details class="group open:bg-neutral-50/40 transition-colors" open>
                <summary class="flex justify-between items-center px-4 py-3.5 sm:px-5 sm:py-4 font-sans text-xs sm:text-sm font-bold text-[#121212] cursor-pointer select-none group-hover:text-[#9E4719] transition-colors list-none">
                  <span class="flex items-center gap-2.5">
                    <span class="w-7 h-7 rounded-lg bg-[#9E4719]/10 text-[#9E4719] flex items-center justify-center">
                      <BookOpen class="w-3.5 h-3.5 text-[#9E4719]" />
                    </span>
                    <span>Filosofi & Detail Busana</span>
                  </span>
                  <div class="w-6 h-6 rounded-full bg-neutral-100 flex items-center justify-center text-[#9E4719] group-open:rotate-180 transition-transform">
                    <ChevronDown class="w-3.5 h-3.5 text-[#9E4719]" />
                  </div>
                </summary>
                <div class="px-4 pb-4 sm:px-5 sm:pb-5 pt-1 product-prose border-t border-neutral-100" set:html={product.descriptionHtml} />
              </details>

              <!-- Accordion 2: Material & Furing -->
              <details class="group open:bg-neutral-50/40 transition-colors">
                <summary class="flex justify-between items-center px-4 py-3.5 sm:px-5 sm:py-4 font-sans text-xs sm:text-sm font-bold text-[#121212] cursor-pointer select-none group-hover:text-[#9E4719] transition-colors list-none">
                  <span class="flex items-center gap-2.5">
                    <span class="w-7 h-7 rounded-lg bg-[#C5A059]/15 text-[#9E4719] flex items-center justify-center">
                      <Layers class="w-3.5 h-3.5 text-[#9E4719]" />
                    </span>
                    <span>Spesifikasi Bahan & Furing</span>
                  </span>
                  <div class="w-6 h-6 rounded-full bg-neutral-100 flex items-center justify-center text-[#9E4719] group-open:rotate-180 transition-transform">
                    <ChevronDown class="w-3.5 h-3.5 text-[#9E4719]" />
                  </div>
                </summary>
                <div class="px-4 pb-4 sm:px-5 sm:pb-5 pt-3 border-t border-neutral-100 font-sans text-xs sm:text-sm leading-relaxed text-[#333333] space-y-2">
                  <div class="flex items-start gap-2">
                    <span class="text-[#9E4719] font-bold">✓</span>
                    <span><strong>Kasta Busana:</strong> <span class="font-bold text-[#9E4719]">{tierInfo.name}</span></span>
                  </div>
                  <div class="flex items-start gap-2">
                    <span class="text-[#9E4719] font-bold">✓</span>
                    <span><strong>Bahan Dasar:</strong> {tierInfo.material}</span>
                  </div>
                  <div class="flex items-start gap-2">
                    <span class="text-[#9E4719] font-bold">✓</span>
                    <span><strong>Lapisan Dalam:</strong> Dilapisi Furing Hero katun halus, sejuk di kulit dan tidak menerawang saat beraktivitas.</span>
                  </div>
                  <div class="flex items-start gap-2">
                    <span class="text-[#9E4719] font-bold">✓</span>
                    <span><strong>Jahitan:</strong> Standar butik resmi Semarang dengan jahitan kuat, presisi, dan kancing tertutup rapi.</span>
                  </div>
                </div>
              </details>

              <!-- Accordion 3: Panduan Perawatan -->
              <details class="group open:bg-neutral-50/40 transition-colors">
                <summary class="flex justify-between items-center px-4 py-3.5 sm:px-5 sm:py-4 font-sans text-xs sm:text-sm font-bold text-[#121212] cursor-pointer select-none group-hover:text-[#9E4719] transition-colors list-none">
                  <span class="flex items-center gap-2.5">
                    <span class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center">
                      <Sparkles class="w-3.5 h-3.5 text-emerald-700" />
                    </span>
                    <span>Panduan Perawatan Batik</span>
                  </span>
                  <div class="w-6 h-6 rounded-full bg-neutral-100 flex items-center justify-center text-[#9E4719] group-open:rotate-180 transition-transform">
                    <ChevronDown class="w-3.5 h-3.5 text-[#9E4719]" />
                  </div>
                </summary>
                <div class="px-4 pb-4 sm:px-5 sm:pb-5 pt-3 border-t border-neutral-100 font-sans text-xs sm:text-sm leading-relaxed text-[#333333] space-y-2">
                  <p class="flex items-start gap-2">
                    <span class="w-4 h-4 rounded-full bg-neutral-200 text-neutral-700 font-mono text-[10px] font-bold flex items-center justify-center flex-shrink-0 mt-0.5">1</span>
                    <span>Cuci menggunakan sabun lerak alami atau deterjen cair lembut non-pemutih.</span>
                  </p>
                  <p class="flex items-start gap-2">
                    <span class="w-4 h-4 rounded-full bg-neutral-200 text-neutral-700 font-mono text-[10px] font-bold flex items-center justify-center flex-shrink-0 mt-0.5">2</span>
                    <span>Hindari memeras kain terlalu kuat atau menggunakan mesin pengering putar.</span>
                  </p>
                  <p class="flex items-start gap-2">
                    <span class="w-4 h-4 rounded-full bg-neutral-200 text-neutral-700 font-mono text-[10px] font-bold flex items-center justify-center flex-shrink-0 mt-0.5">3</span>
                    <span>Jemur membentang di tempat teduh yang berangin tanpa terkena sinar matahari terik langsung.</span>
                  </p>
                  <p class="flex items-start gap-2">
                    <span class="w-4 h-4 rounded-full bg-neutral-200 text-neutral-700 font-mono text-[10px] font-bold flex items-center justify-center flex-shrink-0 mt-0.5">4</span>
                    <span>Setrika pada suhu katun sedang atau lapisi kain tipis di atas permukaan motif batik.</span>
                  </p>
                </div>
              </details>
            </div>

            <!-- Trust Badge (Batik Smile Semarang 2007) -->
            <div class="p-3 sm:p-3.5 rounded-xl bg-amber-50/80 border border-amber-200/80 flex items-center gap-3 text-left">
              <ShieldCheck class="w-5 h-5 text-[#9E4719] flex-shrink-0" />
              <div>
                <span class="font-sans text-xs font-bold text-[#9E4719] block leading-tight">
                  Layanan 3S 1C 1T 1H • Butik Semarang Sejak 2007
                </span>
                <p class="font-sans text-[11px] text-[#505050] mt-0.5 leading-normal">
                  Garansi penukaran ukuran bila kurang pas • Showroom Pamularsih & Banyumanik
                </p>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>

    <!-- CROSS-SELLING SECTION -->
    {relatedProducts.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 sm:mt-20 pt-12 border-t border-neutral-200">
        <div class="text-center mb-8 sm:mb-10">
          <span class="font-sans text-xs uppercase tracking-[0.25em] text-[#9E4719] font-bold block mb-1">
            Harmoni Nusantara
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl text-[#121212] font-semibold leading-[1.2]">
            Padukan Dengan Pasangannya
          </h2>
          <BatikDivider variant="bronze" className="my-2.5" />
          <p class="font-sans text-xs sm:text-sm text-[#505050] mt-1 leading-[1.6]">
            Sempurnakan penampilan keluarga Anda dengan kombinasi sarimbit selaras.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 gap-2.5 sm:gap-5 lg:gap-6">
          {relatedProducts.map((rel: any) => {
            const relImg = rel.images?.edges?.[0]?.node?.url || "https://cdn.shopify.com/s/files/1/0813/3224/0441/collections/banner_batik_couple_1785995932731_51f1e349-35df-4896-b08d-6290f84897d9.jpg?v=1786005734";
            const minPrice = parseInt(rel.priceRange?.minVariantPrice?.amount || "0");
            const comparePrice = parseInt(rel.compareAtPriceRange?.maxVariantPrice?.amount || "0");
            const relPriceStr = `Rp ${minPrice.toLocaleString('id-ID')}`;
            const comparePriceStr = comparePrice > minPrice ? `Rp ${comparePrice.toLocaleString('id-ID')}` : undefined;

            return (
              <ProductCard
                title={rel.title}
                price={relPriceStr}
                compareAtPrice={comparePriceStr}
                image={relImg}
                href={`/products/${rel.handle}`}
                material={rel.tags?.[0] || 'Karya Serasi'}
                variant="essential"
              />
            );
          })}
        </div>
      </section>
    )}

  </div>

  <!-- MODAL PANDUAN UKURAN (SIZE GUIDE - BESPOKE TABLE) -->
  <div id="modal-size-guide" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/70 backdrop-blur-sm animate-fade-in">
    <div class="bg-[#FAF7F2] rounded-2xl sm:rounded-3xl max-w-2xl w-full p-5 sm:p-8 shadow-2xl border border-neutral-200 relative max-h-[90vh] overflow-y-auto">
      
      <button id="btn-close-size-guide" class="absolute top-4 right-4 sm:top-5 sm:right-5 w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/5 hover:bg-[#9E4719] hover:text-white flex items-center justify-center text-sm font-bold transition-colors cursor-pointer">
        ✕
      </button>

      <div class="text-center mb-5">
        <span class="text-[#9E4719] font-sans text-xs uppercase tracking-[0.25em] font-bold block mb-1">
          Standar Butik Batik Smile
        </span>
        <h3 class="font-serif text-xl sm:text-2xl font-semibold text-[#121212]">Tabel Panduan Ukuran Pas Badan</h3>
      </div>

      <!-- Size Table Tabs -->
      <div class="space-y-4 sm:space-y-6">
        <div class="bg-white p-3.5 sm:p-5 rounded-xl sm:rounded-2xl border border-neutral-200 shadow-xs">
          <h4 class="font-sans text-xs sm:text-sm uppercase tracking-wider font-bold text-[#9E4719] mb-2.5 pb-1 border-b border-neutral-200">
            1. Pria (Kemeja Lengan Panjang & Hem Furing)
          </h4>
          <div class="overflow-x-auto">
            <table class="w-full text-xs sm:text-sm text-left border-collapse">
              <thead>
                <tr class="bg-neutral-100 text-[#121212]">
                  <th class="p-2 sm:p-3 font-bold">Ukuran</th>
                  <th class="p-2 sm:p-3 font-bold">Lingkar Dada (LD)</th>
                  <th class="p-2 sm:p-3 font-bold">Lebar Bahu</th>
                  <th class="p-2 sm:p-3 font-bold">Panjang Baju</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-neutral-100 text-[#2A2A2A]">
                <tr><td class="p-2 sm:p-3 font-bold">S</td><td class="p-2 sm:p-3">104 cm</td><td class="p-2 sm:p-3">44 cm</td><td class="p-2 sm:p-3">70 cm</td></tr>
                <tr><td class="p-2 sm:p-3 font-bold">M</td><td class="p-2 sm:p-3">108 cm</td><td class="p-2 sm:p-3">46 cm</td><td class="p-2 sm:p-3">72 cm</td></tr>
                <tr><td class="p-2 sm:p-3 font-bold">L</td><td class="p-2 sm:p-3">112 cm</td><td class="p-2 sm:p-3">48 cm</td><td class="p-2 sm:p-3">74 cm</td></tr>
                <tr><td class="p-2 sm:p-3 font-bold">XL</td><td class="p-2 sm:p-3">116 cm</td><td class="p-2 sm:p-3">50 cm</td><td class="p-2 sm:p-3">76 cm</td></tr>
                <tr><td class="p-2 sm:p-3 font-bold">XXL</td><td class="p-2 sm:p-3">120 cm</td><td class="p-2 sm:p-3">52 cm</td><td class="p-2 sm:p-3">78 cm</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="bg-white p-3.5 sm:p-5 rounded-xl sm:rounded-2xl border border-neutral-200 shadow-xs">
          <h4 class="font-sans text-xs sm:text-sm uppercase tracking-wider font-bold text-[#9E4719] mb-2.5 pb-1 border-b border-neutral-200">
            2. Wanita (Blus, Tunik, Gamis & Kebaya)
          </h4>
          <div class="overflow-x-auto">
            <table class="w-full text-xs sm:text-sm text-left border-collapse">
              <thead>
                <tr class="bg-neutral-100 text-[#121212]">
                  <th class="p-2 sm:p-3 font-bold">Ukuran</th>
                  <th class="p-2 sm:p-3 font-bold">Lingkar Dada (LD)</th>
                  <th class="p-2 sm:p-3 font-bold">Panjang Baju</th>
                  <th class="p-2 sm:p-3 font-bold">Panjang Gamis</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-neutral-100 text-[#2A2A2A]">
                <tr><td class="p-2 sm:p-3 font-bold">S</td><td class="p-2 sm:p-3">92 cm</td><td class="p-2 sm:p-3">70 cm</td><td class="p-2 sm:p-3">135 cm</td></tr>
                <tr><td class="p-2 sm:p-3 font-bold">M</td><td class="p-2 sm:p-3">96 cm</td><td class="p-2 sm:p-3">72 cm</td><td class="p-2 sm:p-3">138 cm</td></tr>
                <tr><td class="p-2 sm:p-3 font-bold">L</td><td class="p-2 sm:p-3">100 cm</td><td class="p-2 sm:p-3">74 cm</td><td class="p-2 sm:p-3">140 cm</td></tr>
                <tr><td class="p-2 sm:p-3 font-bold">XL</td><td class="p-2 sm:p-3">104 cm</td><td class="p-2 sm:p-3">76 cm</td><td class="p-2 sm:p-3">140 cm</td></tr>
                <tr><td class="p-2 sm:p-3 font-bold">XXL</td><td class="p-2 sm:p-3">110 cm</td><td class="p-2 sm:p-3">78 cm</td><td class="p-2 sm:p-3">142 cm</td></tr>
              </tbody>
            </table>
