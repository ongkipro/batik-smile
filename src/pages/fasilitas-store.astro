---
// src/pages/fasilitas-store.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Fasilitas Toko & Showroom 3 Lantai | Batik Smile Semarang">
  <div class="min-h-screen py-16 sm:py-24 bg-[#FAF7F2] text-[#161616]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center mb-16">
        <span class="text-[#9E4719] font-sans text-xs uppercase tracking-[0.3em] font-semibold mb-2 block">
          Online to Offline (O2O) Experience
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal text-[#161616]">
          Pengalaman Belanja Nyaman di Showroom 3 Lantai
        </h1>
        <p class="font-sans text-sm sm:text-base text-[#161616]/75 mt-3 max-w-2xl mx-auto font-light leading-relaxed">
          Batik Smile menghadirkan konsep butik modern yang luas, sejuk ber-AC, dan penerangan optimal agar Anda dan keluarga merasa nyaman saat memilih koleksi batik terbaik di Semarang.
        </p>
      </div>

      <!-- 3 Floors Detailed Breakdown -->
      <div class="space-y-8 mb-16">
        
        <!-- Floor 1 -->
        <div class="p-8 sm:p-10 rounded-3xl bg-white border border-[#161616]/10 shadow-sm flex flex-col md:flex-row gap-8 items-center">
          <div class="w-16 h-16 rounded-2xl bg-[#9E4719]/10 text-[#9E4719] font-serif text-3xl font-bold flex items-center justify-center flex-shrink-0">
            01
          </div>
          <div class="flex-1 space-y-2.5">
            <span class="text-[10px] uppercase tracking-[0.25em] font-bold text-[#9E4719] block">Lantai 1</span>
            <h3 class="font-serif text-2xl sm:text-3xl text-[#161616]">Koleksi Busana Siap Pakai (Ready-to-Wear)</h3>
            <p class="font-sans text-xs sm:text-sm text-[#161616]/75 leading-relaxed font-light">
              Pusat koleksi busana batik modern pria dan wanita dengan kualitas premium. Tersedia kemeja pria lengan panjang lapis furing, hem santai, blus kantor wanita, tunik modern, outer etnik, long dress/gamis batik, hingga daster katun halus.
            </p>
            <div class="pt-2 text-xs text-[#9E4719] font-medium flex items-center gap-2">
              <span>✓ Dilengkapi Fitting Room luas & bersih</span>
            </div>
          </div>
        </div>

        <!-- Floor 2 -->
        <div class="p-8 sm:p-10 rounded-3xl bg-white border border-[#161616]/10 shadow-sm flex flex-col md:flex-row gap-8 items-center">
          <div class="w-16 h-16 rounded-2xl bg-[#C5A059]/20 text-[#C5A059] font-serif text-3xl font-bold flex items-center justify-center flex-shrink-0">
            02
          </div>
          <div class="flex-1 space-y-2.5">
            <span class="text-[10px] uppercase tracking-[0.25em] font-bold text-[#C5A059] block">Lantai 2</span>
            <h3 class="font-serif text-2xl sm:text-3xl text-[#161616]">Galeri Kain Batik, Sutra & Tenun Nusantara</h3>
            <p class="font-sans text-xs sm:text-sm text-[#161616]/75 leading-relaxed font-light">
              Surga bagi pecinta tekstil tradisional. Menyajikan ribuan lembar kain katun primisima, dobby bertekstur, lurik klasik, tenun Troso Jepara, songket, hingga sutra mewah Solo & Jogja untuk dijahit kustom atau dikoleksi.
            </p>
            <div class="pt-2 text-xs text-[#9E4719] font-medium flex items-center gap-2">
              <span>✓ Dilengkapi Sofa Lounge nyaman untuk beristirahat saat memilih motif</span>
            </div>
          </div>
        </div>

        <!-- Floor 3 -->
        <div class="p-8 sm:p-10 rounded-3xl bg-white border border-[#161616]/10 shadow-sm flex flex-col md:flex-row gap-8 items-center">
          <div class="w-16 h-16 rounded-2xl bg-[#9E4719]/10 text-[#9E4719] font-serif text-3xl font-bold flex items-center justify-center flex-shrink-0">
            03
          </div>
          <div class="flex-1 space-y-2.5">
            <span class="text-[10px] uppercase tracking-[0.25em] font-bold text-[#9E4719] block">Lantai 3</span>
            <h3 class="font-serif text-2xl sm:text-3xl text-[#161616]">Pusat Kerajinan, Aksesoris & Oleh-Oleh Khas Semarang</h3>
            <p class="font-sans text-xs sm:text-sm text-[#161616]/75 leading-relaxed font-light">
              Lengkapi kunjungan Anda dengan cenderamata etnik Jawa Tengah: bros kebaya, kalung & gelang etnik, blangkon adat Jawa, kerajinan anyaman, tas batik, dan oleh-oleh khas Kota Semarang untuk keluarga tercinta.
            </p>
            <div class="pt-2 text-xs text-[#9E4719] font-medium flex items-center gap-2">
              <span>✓ Koleksi oleh-oleh khas Semarang terlengkap</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Outlets Directory CTA -->
      <div class="text-center p-10 rounded-3xl bg-[#141414] text-[#FAF7F2] shadow-2xl">
        <h3 class="font-serif text-3xl text-white mb-3">
          Kunjungi Showroom Kami di Semarang
        </h3>
        <p class="font-sans text-xs sm:text-sm text-white/70 mb-6 font-light max-w-xl mx-auto leading-relaxed">
          Showroom 3 Lantai Pamularsih (Semarang Barat) & Store Banyumanik (Semarang Atas) siap menyambut kehadiran Anda.
        </p>
        <a 
          href="/lokasi-toko"
          class="inline-flex items-center justify-center px-8 py-4 bg-[#9E4719] hover:bg-[#7A320C] text-white font-sans text-xs uppercase tracking-[0.2em] font-bold rounded-lg shadow-xl transition-all"
        >
          Lihat Alamat & Petunjuk Arah →
        </a>
      </div>

    </div>
  </div>
</Layout>
