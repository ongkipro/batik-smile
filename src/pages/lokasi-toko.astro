---
// src/pages/lokasi-toko.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lokasi Toko & Kontak Resmi | Batik Smile Semarang">
  <div class="min-h-screen py-16 sm:py-24 bg-[#FAF7F2] text-[#161616]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center mb-16">
        <span class="text-[#9E4719] font-sans text-xs uppercase tracking-[0.3em] font-semibold mb-2 block">
          Showroom & Kontak
        </span>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal text-[#161616]">
          Kunjungi Outlet Kami di Semarang
        </h1>
        <p class="font-sans text-sm sm:text-base text-[#161616]/75 mt-3 max-w-2xl mx-auto font-light leading-relaxed">
          Kami menyambut kehadiran Anda dan keluarga di 2 outlet resmi Batik Smile di Kota Semarang dengan ruang ber-AC, parkir memadai, dan pelayanan 3S 1C 1T 1H.
        </p>
      </div>

      <!-- 2 Outlets Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        
        <!-- Outlet 1: Pamularsih (Showroom 3 Lantai) -->
        <div class="p-8 sm:p-10 rounded-3xl bg-white border border-[#161616]/10 shadow-sm space-y-4">
          <div class="inline-block px-3 py-1 bg-[#9E4719]/10 text-[#9E4719] text-[10px] uppercase tracking-widest font-bold rounded">
            Showroom Utama (3 Lantai)
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl text-[#161616]">1. Batik Smile — Pamularsih</h2>
          
          <div class="space-y-2 text-xs sm:text-sm text-[#161616]/75 font-light leading-relaxed">
            <p><strong>Alamat Lengkap:</strong><br>Jl. Simongan Raya No. 109, Pamularsih, Semarang Barat, Jawa Tengah</p>
            <p><strong>Fasilitas:</strong> Showroom 3 Lantai (Ready-to-Wear, Galeri Kain & Sutra, Pusat Kerajinan & Oleh-oleh Semarang, Ruang Ganti, Sofa Lounge, Area Parkir).</p>
            <p><strong>Layanan:</strong> Penjualan retail, konsultasi seragam instansi/keluarga, dan penerimaan pesanan jahit kustom.</p>
          </div>

          <div class="pt-4 border-t border-[#161616]/10">
            <a 
              href="https://maps.google.com/?q=Batik+Smile+Pamularsih+Semarang" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center text-xs uppercase tracking-widest font-bold text-[#9E4719] hover:underline"
            >
              Buka di Google Maps →
            </a>
          </div>
        </div>

        <!-- Outlet 2: Banyumanik -->
        <div class="p-8 sm:p-10 rounded-3xl bg-white border border-[#161616]/10 shadow-sm space-y-4">
          <div class="inline-block px-3 py-1 bg-[#C5A059]/20 text-[#9E4719] text-[10px] uppercase tracking-widest font-bold rounded">
            Store Cabang
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl text-[#161616]">2. Batik Smile — Banyumanik</h2>
          
          <div class="space-y-2 text-xs sm:text-sm text-[#161616]/75 font-light leading-relaxed">
            <p><strong>Alamat Lengkap:</strong><br>Jl. Sukun Raya No. 23, Banyumanik, Semarang, Jawa Tengah</p>
            <p><strong>Fasilitas:</strong> Display busana batik lengkap pria, wanita & anak, fitting room nyaman, dan parkir kendaraan.</p>
            <p><strong>Layanan:</strong> Penjualan retail pakaian jadi dan pesanan jahit kustom.</p>
          </div>

          <div class="pt-4 border-t border-[#161616]/10">
            <a 
              href="https://maps.google.com/?q=Batik+Smile+Banyumanik+Semarang" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center text-xs uppercase tracking-widest font-bold text-[#9E4719] hover:underline"
            >
              Buka di Google Maps →
            </a>
          </div>
        </div>

      </div>

      <!-- Official Contact Channels -->
      <div class="p-8 sm:p-12 rounded-3xl bg-[#141414] text-[#FAF7F2] shadow-2xl">
        <h3 class="font-serif text-3xl text-white mb-6 text-center">
          Kontak Resmi & Layanan Pelanggan
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
          
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 space-y-2">
            <span class="text-2xl block">💬</span>
            <span class="font-sans text-xs uppercase tracking-widest text-[#C5A059] font-bold block">WhatsApp CS & Pesanan</span>
            <p class="font-serif text-xl text-white font-medium">081-390-8888-09</p>
            <a href="https://wa.me/6281390888809" target="_blank" rel="noopener noreferrer" class="text-xs text-[#25D366] hover:underline block pt-1">
              Chat Sekarang →
            </a>
          </div>

          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 space-y-2">
            <span class="text-2xl block">📸</span>
            <span class="font-sans text-xs uppercase tracking-widest text-[#C5A059] font-bold block">Instagram Resmi</span>
            <p class="font-serif text-xl text-white font-medium">@Batiksmile.official</p>
            <a href="https://instagram.com/Batiksmile.official" target="_blank" rel="noopener noreferrer" class="text-xs text-pink-400 hover:underline block pt-1">
              Kunjungi Profil →
            </a>
          </div>

          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 space-y-2">
            <span class="text-2xl block">🛍️</span>
            <span class="font-sans text-xs uppercase tracking-widest text-[#C5A059] font-bold block">Shopee Official</span>
            <p class="font-serif text-xl text-white font-medium">Batik Smile Premium</p>
            <a href="https://shopee.co.id" target="_blank" rel="noopener noreferrer" class="text-xs text-orange-400 hover:underline block pt-1">
              Buka Toko Shopee →
            </a>
          </div>

        </div>

        <div class="mt-8 pt-6 border-t border-white/10 text-center text-xs text-white/60 font-light">
          Metode Pembayaran Resmi: Online (Shopify Encrypted Checkout, Transfer Bank, QRIS) & Offline Store (Cash, Debit EDC, QRIS).
        </div>

      </div>

    </div>
  </div>
</Layout>
